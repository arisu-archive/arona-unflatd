{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Decompile flatdata",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "args": [
        "d",
        "-i",
        "${workspaceFolder}/tmp/DiffableCs/BlueArchive",
        "-o",
        "${workspaceFolder}/tmp/output/flatdata",
        "-n",
        "FlatData"
      ]
    },
    {
      "name": "Decompile ExcelData",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "args": [
        "d",
        "-i",
        "${workspaceFolder}/tmp/DiffableCs/BlueArchive",
        "-o",
        "${workspaceFolder}/tmp/output/excel",
        "-n",
        "MX.Data.Excel"
      ]
    }
  ]
}